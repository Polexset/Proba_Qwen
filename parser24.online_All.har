            "mimeType": "text/css",
            "text": "\r\n/*чтоб меню контент не загораживало*/\r\nbody {\r\n  padding-top: 70px;\r\n}\r\n\r\n\r\n#block_parser .btn-primary  {\r\n    margin-left: 0px;\r\n    font-size: 17px;\r\n    width: 300px;\r\n}\r\n#block_parser .btn-info{\r\n    margin-left: 0px;\r\n    font-size: 17px;\r\n    width: 300px;\r\n}\r\n\r\n\r\n#block_about, #block_parser, #block_ads,#block_contact_parser,#block_data_parser, #block_comments_parser,#block_comments{\r\n    padding: 10px 0px;\r\n}\r\n\r\n#block_comments_parser p{\r\n    word-break: break-word;\r\n}\r\n\r\n.modal .btn{\r\n    /*margin-left: 10px;\r\n    margin-bottom: 10px;*/\r\n    margin:10px 10px;\r\n    margin-top: 5px;\r\n    font-size: 15px;\r\n    width: 250px;\r\n}\r\n#block_about .section-btn  .btn-secondary{\r\n    margin-left: 0px;\r\n    margin-top:10px;\r\n    font-size: 15px;\r\n    width: 300px;\r\n}\r\nh2{\r\n    font-size: 25px;\r\n    margin-top: 0;\r\n    text-transform:uppercase;\r\n}\r\n.modal p{\r\n    margin-bottom: 5px;\r\n}\r\n.blue-test{\r\n    color:#2b8cca;\r\n}\r\n#block_ads .table{\r\n    font-size: 15px;\r\n}\r\n#block_ads .table a{\r\n    font-size: 15px;\r\n}\r\n#table_order_list td.details-control {\r\n    background: url('https://datatables.net/examples/resources/details_open.png') no-repeat center center;\r\n    cursor: pointer;\r\n}\r\n#table_order_list tr.details td.details-control {\r\n    background: url('https://datatables.net/examples/resources/details_close.png') no-repeat center center;\r\n}\r\n#table_proxy_list td.details-control {\r\n    background: url('https://datatables.net/examples/resources/details_open.png') no-repeat center center;\r\n    cursor: pointer;\r\n}\r\n#table_proxy_list tr.details td.details-control {\r\n    background: url('https://datatables.net/examples/resources/details_close.png') no-repeat center center;\r\n}\r\n#block_contact_parser .btn-primary, #block_about .btn-primary,#block_comments .btn-primary{\r\n    margin-left: 0px;\r\n    font-size: 17px;\r\n    width: 300px;\r\n}\r\n#block_data_parser .btn-primary{\r\n     margin-left: 0px;\r\n    font-size: 17px;\r\n    width: 320px;\r\n}\r\n#section_order_list,#section_order_history #section_log_action,#section_order_list a, #section_log_action a{\r\n    font-size: 14px;\r\n}\r\n/*#delete, #stop, #edit {\r\n    margin-right: 10px;\r\n}*/\r\n#table_order_list td{\r\n    padding: 5px 5px;\r\n    min-width: 20px;\r\n    word-wrap:break-word;\r\n}\r\n#table_order_list td .knopki{\r\n    min-width: 100px;\r\n}\r\n#table_proxy_list td{\r\n    padding: 5px 5px;\r\n    min-width: 20px;\r\n    word-wrap:break-word;\r\n}\r\n/*========= #table_order_history =========================*/\r\n\r\n#table_order_history td{\r\n    padding: 5px 5px;\r\n    min-width: 20px; \r\n    max-width: 600px;\r\n    word-wrap:break-word;\r\n}\r\n#table_order_history td.details-control {\r\n    background: url('https://datatables.net/examples/resources/details_open.png') no-repeat center center;\r\n    cursor: pointer;\r\n}\r\n#table_order_history tr.details td.details-control {\r\n    background: url('https://datatables.net/examples/resources/details_close.png') no-repeat center center;\r\n}\r\n\r\n/*========= table_autoload =========================*/\r\n\r\n#table_autoload td{\r\n    padding: 5px 5px;\r\n    min-width: 20px; \r\n    max-width: 400px;\r\n    word-wrap:break-word;\r\n}\r\n/*========= #block_comments =========================*/\r\n    #block_comments h2{\r\n        margin-bottom:20px;\r\n    }\r\n    #block_comments .img-sm {\r\n     width: 48px;\r\n     height: 48px;\r\n    }\r\n    #block_comments .panel {\r\n     box-shadow: 0 2px 0 rgba(0,0,0,0.075);\r\n     border-radius: 0;\r\n     border: 0;\r\n     margin-bottom: 15px;\r\n    }\r\n    #block_comments .panel .panel-footer, #block_comments .panel>:last-child {\r\n     border-bottom-left-radius: 0;\r\n     border-bottom-right-radius: 0;\r\n    }\r\n    #block_comments .panel .panel-heading, #block_comments .panel>:first-child {\r\n     border-top-left-radius: 0;\r\n     border-top-right-radius: 0;\r\n    }\r\n    #block_comments .panel-body {\r\n     padding: 10px 10px;\r\n     padding-bottom:0px;\r\n    }\r\n    #block_comments .media-block .media-left {\r\n     display: block;\r\n     float: left\r\n    }\r\n    #block_comments .media-block .media-right {\r\n     float: right\r\n    }\r\n    #block_comments .media-block .media-body {\r\n     display: block;\r\n     overflow: hidden;\r\n     width: auto\r\n    }\r\n    #block_comments .middle .media-left,\r\n    .middle .media-right,\r\n    .middle .media-body {\r\n     vertical-align: middle\r\n    }\r\n    #block_comments .thumbnail {\r\n     border-radius: 0;\r\n     border-color: #e9e9e9\r\n    }\r\n    #block_comments .tag .tag-sm, #block_comments .btn-group-sm > .tag {\r\n     padding: 5px 10px;\r\n    }\r\n    #block_comments .tag:not(.label) {\r\n     background-color: #fff;\r\n     padding: 6px 12px;\r\n     border-radius: 2px;\r\n     border: 1px solid #cdd6e1;\r\n     font-size: 12px;\r\n     line-height: 1.42857;\r\n     vertical-align: middle;\r\n     -webkit-transition: all .15s;\r\n     transition: all .15s;\r\n    }\r\n    #block_comments .text-muted, #block_comments a.text-muted:hover, #block_comments a.text-muted:focus {\r\n     color: #acacac;\r\n    }\r\n    #block_comments .text-sm {\r\n     font-size: 0.9em;\r\n    }\r\n    #block_comments .text-5x, #block_comments .text-4x, #block_comments .text-5x, #block_comments .text-2x, #block_comments .text-lg, #block_comments .text-sm, #block_comments .text-xs {\r\n     line-height: 1.25;\r\n    }\r\n    #block_comments .btn-trans {\r\n     background-color: transparent;\r\n     border-color: transparent;\r\n     color: #929292;\r\n    }\r\n    #block_comments .btn-icon {\r\n     text-transform: uppercase;\r\n        padding: 9px 9px;\r\n        margin: 0px 10px;\r\n        transition: background .5s;\r\n        width: 30px;\r\n    }\r\n    #block_comments .btn-sm, #block_comments .btn-group-sm>.btn, #block_comments .btn-icon.btn-sm {\r\n     padding: 5px 10px !important;\r\n    }\r\n    #block_comments .mar-top {\r\n     margin-top: 15px;\r\n    }\r\n    #block_comments #send_btn{\r\n        margin-bottom:0px;\r\n        width: 150px;\r\n        \r\n    }\r\n    #block_comments p{\r\n    word-break: break-word;\r\n    }\r\n/*========= #block_help =========================*/    \r\n    .block_help {\r\n    padding: 1.5rem;\r\n    margin-right: 0;\r\n    margin-left: 0;\r\n    border-width: .2rem;\r\n  }\r\n    \r\n/*========= #section_notification =========================*/  \r\n  \r\n/*#section_notification .unread{\r\n    font-weight: bold;\r\n} */\r\n    /*========= #block_autoparser_edit =========================*/ \r\n#block_autoparser_edit .time_del, .time_add{\r\n    font-size: 14px;\r\n    width: 120px; \r\n    padding: 0px 0px;\r\n    /*margin: 0px 10px ;*/\r\n    margin-top: 0px;\r\n    margin-left: 0px;\r\n    margin-right: 10px;\r\n    height: 37px;\r\n    margin-bottom: 10px;\r\n}\r\n#block_autoparser_edit .select_rasp_day, .select_rasp_time{\r\n    margin-bottom: 10px;\r\n    margin-right: 10px;\r\n}\r\n#block_autoparser_edit .select_text{\r\n    margin-top: 5px;\r\n}\r\n#block_autoparser_edit #savebtn, #cnclbtn{\r\n    margin-left: 0px;\r\n}"
          },
