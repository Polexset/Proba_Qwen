          "content": {
            "size": 5857,
            "mimeType": "text/css",
            "text": "\nhtml, body{\n\theight: 100%;\n}\nbody {\n  background: #fff;\n  font-family: Ubuntu, sans-serif;\n  font-size: 17px;\n  color:  #434c59; /*цвет текста*/\n  font-weight: 400;\n  min-width: 320px;\n\n}\n\n/*ссылки*/\na{\n    font-family: Montserrat, sans-serif;\n    font-weight: 400;\n    font-size: 17px;\n    color: #458cca;\n}\n/*при наведении*/\na:hover{\n    color: #2cc7c1;\n}\n.underline{\n     text-decoration: underline;\n}\n.purple_color{\ncolor: #a169f7;\n}\nimg{\n    height:auto;\n    max-width: 100%;\n}\nsection{/*:not(#block_comments)*/\n    position: relative; /*позиционировать внутри секции*/\n    padding: 15px 0 30px 0;\n}\n\nh2{\n    font-family: Montserrat, sans-serif;\n    font-size: 28px;\n    margin-top: 0;\n    text-transform:uppercase;\n}\n.blue{\n    color: #458cca;\n    font-weight: bold;\n}\n.orange{\n    color: #ffc107;\n}\n\n.btn{\n    font-family: Montserrat, sans-serif;\n    font-size: 18px;\n    text-transform:uppercase;\n    padding:10px 20px; /*отступ от текста*/\n    margin:0px 20px ;/*отступ наружние*/\n    transition:background .5s;\n    width: 350px;\n}\n/*для формы логин не надо отступ*/\n#section_login .btn, #section_pay_add .btn{\n    margin-left: 0px;\n}\n.btn-outline-success{\n    width: 13px;\n    font-size: 13px;\n\n    padding:5px 5px; /*отступ от текста*/\n    margin:0px 5px ;/*отступ наружние*/\n}\n.btn-outline-dark{\n    width: 13px;\n    font-size: 13px;\n\n    padding:5px 5px; /*отступ от текста*/\n    margin:0px 0px ;/*отступ наружние*/\n}\n/*для каждой кнопки*/\n.btn-primary{\n    background: #ffc107;\n    border-color: #ffc107;\n    color: #000;\n    padding: 10px 10px; /*отступ от текста*/\n    margin: 5px 10px ;/*отступ наружние*/\n}\n\n.btn-primary:hover{\n    background: #ca9d14;\n    border-color: #ca9d14;\n}\n.btn:disabled{\n    background: #a169f7;\n    border-color: #a169f7;\n    color: #fff;\n}\n.btn:disabled:hover{\n    background: #a169f7;\n    border-color: #a169f7;\n    color: #000;\n}\n.btn-info{\n    background: #59a9ff;\n    border-color: #59a9ff;\n    color: #000;\n    padding: 10px 10px; /*отступ от текста*/\n    margin: 5px 10px ;/*отступ наружние*/\n}\n\n.btn-success{\n    background: #97cf26;\n    border-color: #97cf26;\n    color: #000;\n    padding: 10px 10px;\n    margin: 5px 10px ;\n}\np{\n    word-break: break-word;\n}\n/*================ navbar ======================*/\n/* цвет фона и рамки навигационного меню */\n.navbar{\n    background-color: rgba(67,76,89, 0.9);\n    color: #fff;\n}\n.navbar a{\n    color: #fff;\n}\n/* цвет текста, содержащий название сайта или бренда */\n.navbar .logo{\n    color: #fff;\n    font-size: 22px;\n    text-transform: uppercase;\n    font-weight: bold;\n    margin-right:0px;\n    opacity: 1;\n}\n\n.navbar .collapse{\n    margin-left:20px;\n}\n\n\n/* Цвет пунктов навигационного меню */\n.navbar .nav-link{\n    color: rgba(255,255,255,0.9);\n}\n/* цвет текста (название сайта или бренда), при поднесении к нему курсора мышки или при его нахождении в фокусе */\n.navbar .navbar-brand:hover,\n.navbar .navbar-brand:focus,\n.navbar .nav-link:hover,\n.navbar .nav-link:focus{\n    color: #ffc107;\n}\n/* Цвет пунктов меню в раскрывающихся списках */\n.navbar  .dropdown-menu  {\n        color: #ffc107;\n        background-color: rgba(67,76,89, 0.9);\n}\n\n/* Цвет полосочек в кнопочке, которая открывает меню */\n.navbar .navbar-toggler .navbar-toggler-icon{\n    color: #ffc107;\n}\n.navbar .navbar-toggler .navbar-toggler-name {\n   color: #fff;\n}\n/* Цвет фона кнопки (которая открывает меню) при поднесении к ней курсора мышки или при нахождении её в фокусе */\n.navbar .navbar-toggler:hover,\n.navbar .navbar-toggler:focus {\n    color: #ffc107;\n}\n\n\n/*================= footer ==============================*/\n#footer{\n    background-color: #434c59;\n    color: #fff;\n}\n#footer .title {\n    font-size: 22px;\n    font-weight: bold;\n    text-transform: uppercase;\n    color: #ffc107;\n    margin-bottom: 10px;\n    margin-top: 10px;\n}\n\n\n#footer .btn{\n    margin: 0px 0px;\n    margin-top: 5px;\n    font-size: 15px;\n    width: 100%;\n}\n#footer .form-group{\n    margin: 0px 0px;\n}\n\n#footer .pays{\n    margin: 10px 0px;\n}\n\n#footer .logo {\n    border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n    margin-bottom: 10px ;\n    padding-bottom: 20px;\n    color: #fff;\n    font-size: 22px;\n    text-transform: uppercase;\n    font-weight: bold;\n}\n\n#footer .sec {\n\tmargin-top: 10px;\n}\n#footer .sec p{\n\tmargin: 10px 0px;\n}\n/*#footer .sec a{\n\n    color: #fff;\n}*/\n\n#footer .news a{\n    color: #fff;\n}\n#footer ul.news>li>small {\n    display: block;\n}\n\n#footer ul.news>li {\n    padding: 15px 0;\n    border-bottom: rgba(255,255,255,0.07) 1px solid;\n}\n\n/*=====================================================*/\n/* Large Devices, Wide Screens */\n@media only screen and (max-width : 1200px) {\n\n}\n\n/* Medium Devices, Desktops */\n@media only screen and (max-width : 992px) {\n\n}\n\n/* Small Devices, Tablets */\n@media only screen and (max-width : 768px) {\n\n}\n\n@media only screen and (max-width : 450px) {\n\n\th2{\n\t\tfont-size: 20px;\n\t}\n\tp{\n\t\tfont-size: 17px;\n\t}\n\t.btn{\n\t\tfont-size: 15px;\n\t\twidth: 290px;\n\t}\n        .btn-outline-dark{\n            width: 13px;\n            font-size: 13px;\n\n            padding:5px 5px; /*отступ от текста*/\n            margin:0px 0px ;/*отступ наружние*/\n        }\n}\n\n/* Extra Small Devices, Phones */\n@media only screen and (max-width : 480px) {\n\n}\n"
